# Copy to .env and replace the placeholders. Never commit .env.
# Required: secret used to sign and verify JWT access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string

# Only needed when running without Docker.
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@localhost/nlpdb
